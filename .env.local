CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_ACCESS_TOKEN=your_cda_access_token
CONTENTFUL_ENVIRONMENT=master
# Optional, defaults to "siteSettings"
CONTENTFUL_SITE_SETTINGS_TYPE=siteSettings
# Secret shared with the Contentful publish webhook, see app/api/revalidate/route.ts
CONTENTFUL_REVALIDATE_SECRET=choose_a_long_random_string

NTFY_TOPIC=rashmohon-orders
NTFY_SERVER=https://ntfy.sh

